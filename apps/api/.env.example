# --- Local development ---
# Point this at a local Postgres instance, Docker container, or a free cloud
# instance (Neon, Supabase, Railway). See packages/database/.env.example.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/big_eds_retail_os?schema=public"
PORT=4000
NODE_ENV=development

# This API's own publicly reachable base URL. Set this to the real deployed
# API URL (e.g. the Render URL) in production.
PUBLIC_URL="http://localhost:4000"

# Generate real random secrets — e.g. `openssl rand -base64 48` — never reuse
# these placeholder values anywhere beyond local development.
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of exact origins allowed to call this API with
# credentials. Must match the deployed storefront/admin/POS URLs exactly
# (scheme + host, no trailing slash, no path).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Cookie flags. Locally, leave both unset (defaults to non-secure + Lax so
# cookies work over plain http://localhost). In production on Render, these
# default to secure=true / sameSite=none automatically (see src/lib/env.js)
# because the API and the Next.js apps are deployed on different domains —
# only override if you later put everything behind one shared parent domain
# via subdomains, where sameSite=lax is preferable.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# --- Square (sandbox) ---
# Online checkout only — POS card-present tender is a separate, still-stubbed
# integration (Square Terminal) pending a reader model decision; see
# docs/requirements/open-questions.md. Get sandbox values from the Square
# Developer Dashboard (https://developer.squareup.com/apps) -> your
# application -> Sandbox tab: Sandbox Access Token, Sandbox Application ID,
# and a Sandbox Location ID (Locations API or the dashboard's Locations tab).
# The webhook signature key comes from that application's Webhooks subscription
# (create one pointed at {PUBLIC_URL}/api/webhooks/square, subscribed to
# payment.updated) — Square shows the signature key once the subscription is
# saved.
SQUARE_ACCESS_TOKEN="replace-with-your-sandbox-access-token"
SQUARE_WEBHOOK_SIGNATURE_KEY="replace-with-your-webhook-signature-key"
SQUARE_APPLICATION_ID="replace-with-your-sandbox-application-id"
SQUARE_LOCATION_ID="replace-with-your-sandbox-location-id"
# "sandbox" or "production" — stay on sandbox until a human has verified the
# three required test scenarios (paid, declined, no-double-charge-on-retry)
# and explicitly signs off on flipping this, per this repo's CLAUDE.md rule
# that enabling live payments requires explicit human approval.
SQUARE_ENVIRONMENT="sandbox"

# --- Cloudinary (product image storage) ---
# Admin-uploaded product images are stored in Cloudinary, not local disk.
# Get these from your Cloudinary dashboard (https://cloudinary.com/console).
CLOUDINARY_CLOUD_NAME="replace-with-your-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-api-key"
CLOUDINARY_API_SECRET="replace-with-your-api-secret"

# --- Email / SMTP (customer sign-up verification codes) ---
# Used to email the one-time code when a customer creates a storefront
# account. Any SMTP provider works (SendGrid, Mailgun, Postmark, Gmail app
# password, ...). Leave SMTP_HOST unset in local development and the code is
# printed to this API's console instead of being emailed. In production an
# unset SMTP_HOST makes sign-up fail loudly (HTTP 503) rather than pretend a
# code was sent — and the code is never logged.
# SMTP_PORT 587 + SMTP_SECURE=false uses STARTTLS; port 465 needs SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Big Ed's Sofas & Beds <no-reply@example.com>"
# --- Render production values (set these in the Render dashboard, not here) ---
# DATABASE_URL        -> the "Internal Connection String" from your Render
#                        Postgres instance (render.yaml wires this
#                        automatically if you deploy via Blueprint).
# CORS_ORIGINS         -> e.g. "https://your-admin.vercel.app,https://your-storefront.vercel.app"
#                        (add every real Vercel URL/custom domain that needs
#                        to call this API with cookies attached).
# JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET  -> render.yaml auto-generates these if deployed via
#                        Blueprint; set manually and keep private otherwise.
# SQUARE_ACCESS_TOKEN,
# SQUARE_WEBHOOK_SIGNATURE_KEY,
# SQUARE_APPLICATION_ID,
# SQUARE_LOCATION_ID,
# SQUARE_ENVIRONMENT      -> set these manually in the Render dashboard once a
#                        real Square account is connected; render.yaml does
#                        not generate these. Use production-mode credentials
#                        and SQUARE_ENVIRONMENT=production only after the
#                        mandatory production launch checklist (the three
#                        test scenarios in docs/requirements/open-questions.md)
#                        is complete and a human has explicitly approved it.
# CLOUDINARY_CLOUD_NAME,
# CLOUDINARY_API_KEY,
# CLOUDINARY_API_SECRET -> set these manually in the Render dashboard from
#                        your Cloudinary account; render.yaml does not
#                        generate these.
