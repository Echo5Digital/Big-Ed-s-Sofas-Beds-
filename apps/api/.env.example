# --- Local development ---
# Point this at a local Postgres instance, Docker container, or a free cloud
# instance (Neon, Supabase, Railway). See packages/database/.env.example.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/big_eds_retail_os?schema=public"
PORT=4000
NODE_ENV=development

# Generate real random secrets — e.g. `openssl rand -base64 48` — never reuse
# these placeholder values anywhere beyond local development.
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of exact origins allowed to call this API with
# credentials. Must match the deployed storefront/admin URLs exactly
# (scheme + host, no trailing slash, no path).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Cookie flags. Locally, leave both unset (defaults to non-secure + Lax so
# cookies work over plain http://localhost). In production on Render, these
# default to secure=true / sameSite=none automatically (see src/lib/env.js)
# because the API and the Next.js apps are deployed on different domains —
# only override if you later put everything behind one shared parent domain
# via subdomains, where sameSite=lax is preferable.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# --- Render production values (set these in the Render dashboard, not here) ---
# DATABASE_URL        -> the "Internal Connection String" from your Render
#                        Postgres instance (render.yaml wires this
#                        automatically if you deploy via Blueprint).
# CORS_ORIGINS         -> e.g. "https://your-admin.vercel.app,https://your-storefront.vercel.app"
#                        (add every real Vercel URL/custom domain that needs
#                        to call this API with cookies attached).
# JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET  -> render.yaml auto-generates these if deployed via
#                        Blueprint; set manually and keep private otherwise.
