# --- Local development ---
# Point this at a local Postgres instance, Docker container, or a free cloud
# instance (Neon, Supabase, Railway). See packages/database/.env.example.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/big_eds_retail_os?schema=public"
PORT=4000
NODE_ENV=development

# This API's own publicly reachable base URL. Set this to the real deployed
# API URL (e.g. the Render URL) in production.
PUBLIC_URL="http://localhost:4000"

# Generate real random secrets — e.g. `openssl rand -base64 48` — never reuse
# these placeholder values anywhere beyond local development.
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of exact origins allowed to call this API with
# credentials. Must match the deployed storefront/admin/POS URLs exactly
# (scheme + host, no trailing slash, no path).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Cookie flags. Locally, leave both unset (defaults to non-secure + Lax so
# cookies work over plain http://localhost). In production on Render, these
# default to secure=true / sameSite=none automatically (see src/lib/env.js)
# because the API and the Next.js apps are deployed on different domains —
# only override if you later put everything behind one shared parent domain
# via subdomains, where sameSite=lax is preferable.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# --- Stripe (test mode) ---
# Online checkout only — POS card-present tender is a separate, still-stubbed
# integration (Stripe Terminal) pending a reader model decision; see
# docs/requirements/open-questions.md. Get test-mode values from the Stripe
# dashboard (https://dashboard.stripe.com/test/apikeys) and, for local
# webhook delivery, the Stripe CLI (`stripe listen --forward-to
# localhost:4000/api/webhooks/stripe` prints a matching whsec_ secret).
STRIPE_SECRET_KEY="sk_test_replace-with-a-real-test-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-the-webhook-signing-secret"
STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-a-real-test-publishable-key"

# --- Cloudinary (product image storage) ---
# Admin-uploaded product images are stored in Cloudinary, not local disk.
# Get these from your Cloudinary dashboard (https://cloudinary.com/console).
CLOUDINARY_CLOUD_NAME="replace-with-your-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-api-key"
CLOUDINARY_API_SECRET="replace-with-your-api-secret"

# --- Render production values (set these in the Render dashboard, not here) ---
# DATABASE_URL        -> the "Internal Connection String" from your Render
#                        Postgres instance (render.yaml wires this
#                        automatically if you deploy via Blueprint).
# CORS_ORIGINS         -> e.g. "https://your-admin.vercel.app,https://your-storefront.vercel.app"
#                        (add every real Vercel URL/custom domain that needs
#                        to call this API with cookies attached).
# JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET  -> render.yaml auto-generates these if deployed via
#                        Blueprint; set manually and keep private otherwise.
# STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET,
# STRIPE_PUBLISHABLE_KEY -> set these manually in the Render dashboard once a
#                        real Stripe account is connected; render.yaml does
#                        not generate these. Use live-mode keys only after
#                        the mandatory production launch checklist (payment
#                        terminals/webhooks tested against Stripe's
#                        certification process) is complete.
# CLOUDINARY_CLOUD_NAME,
# CLOUDINARY_API_KEY,
# CLOUDINARY_API_SECRET -> set these manually in the Render dashboard from
#                        your Cloudinary account; render.yaml does not
#                        generate these.
