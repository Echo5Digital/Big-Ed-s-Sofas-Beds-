# --- Local development ---
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Vercel production value ---
# Set this in the Vercel project's Environment Variables settings, not here:
# NEXT_PUBLIC_API_URL -> your deployed Render API URL, e.g.
#                        "https://big-eds-retail-os-api.onrender.com"
#                        (no trailing slash). This is a NEXT_PUBLIC_ variable
#                        because the admin app calls the API directly from
#                        the browser, not through a server-side proxy.
