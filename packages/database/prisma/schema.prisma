// Big Ed's Retail OS — core data model.
// Scope this pass: Auth/RBAC, Catalog, Inventory, Purchasing, Orders (e-commerce).
// POS-specific tables (Register, RegisterSession, CashMovement) are included for
// schema completeness per the kickoff plan but are not wired to any API yet —
// POS is explicitly deferred.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

enum RoleName {
  ADMIN
  MANAGER
  STAFF
  CASHIER
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique
  passwordHash           String
  firstName              String
  lastName               String
  isActive               Boolean           @default(true)
  roles                  UserRole[]
  auditLogs              AuditLog[]
  purchaseOrdersCreated  PurchaseOrder[]   @relation("POCreatedBy")
  purchaseOrdersApproved PurchaseOrder[]   @relation("POApprovedBy")
  goodsReceipts          GoodsReceipt[]
  stockMovements         StockMovement[]
  registerSessionsOpened RegisterSession[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([email])
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "inventory:adjust", "purchasing:approve"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "stock.adjust", "po.approve", "order.refund"
  entityType String
  entityId   String
  reasonCode String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Products / Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  image       String?
  parentId    String?
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    Product[]
  productTags ProductCategory[]
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([slug])
}

// Secondary categories a product also appears under, beyond its primary
// Product.categoryId. A product's primary category drives admin-list display
// and the canonical breadcrumb; this join table is purely additive for
// "also show this product on these other category pages."
model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String?
  categoryId   String?
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryTags ProductCategory[]
  brand        String?
  // Product-level display attributes shown on the storefront detail page.
  // Each is optional and hidden from the live page when not set — distinct
  // from Variant.color/size, which vary per sellable SKU.
  itemName     String?
  color        String?
  material     String?
  dimensions   String?
  status       ProductStatus     @default(DRAFT)
  // Manually flagged by staff to appear on the storefront Deals page,
  // independent of whether any variant has a compareAtCents markdown price.
  isDeal       Boolean           @default(false)
  variants     Variant[]
  images       ProductImage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([isDeal])
}

model Variant {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String          @unique
  name           String // e.g. "Charcoal / Queen"
  color          String?
  size           String?
  widthInches    Decimal?        @db.Decimal(8, 2)
  heightInches   Decimal?        @db.Decimal(8, 2)
  depthInches    Decimal?        @db.Decimal(8, 2)
  weightLbs      Decimal?        @db.Decimal(8, 2)
  priceCents     Int // current selling price, in cents (USD)
  compareAtCents Int?
  costCents      Int? // last known supplier cost, in cents
  isActive       Boolean         @default(true)
  priceHistory   PriceHistory[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  reservations   Reservation[]
  transfers      Transfer[]
  orderLines     OrderLine[]
  poLines        POLine[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  // Cloudinary public id (e.g. "products/abc123") — needed to delete or
  // transform this image via the Cloudinary API later. Null for images added
  // by pasting an external URL directly, which Cloudinary doesn't manage.
  publicId  String?
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model PriceHistory {
  id          String   @id @default(uuid())
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceCents  Int
  costCents   Int?
  effectiveAt DateTime @default(now())
  changedBy   String?

  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Stock / Inventory
// ---------------------------------------------------------------------------

enum LocationType {
  SHOWROOM
  WAREHOUSE
}

model Location {
  id            String          @id @default(uuid())
  name          String
  type          LocationType
  isActive      Boolean         @default(true)
  stockBalances StockBalance[]
  movements     StockMovement[]
  reservations  Reservation[]
  transfersFrom Transfer[]      @relation("TransferFrom")
  transfersTo   Transfer[]      @relation("TransferTo")
  counts        Count[]
  goodsReceipts GoodsReceipt[]
  registers     Register[]
  createdAt     DateTime        @default(now())

  @@index([type])
}

// Running balance snapshot per (variant, location). Authoritative quantities
// are derived from StockMovement; this table is a materialized convenience
// cache that every mutating operation updates inside the same transaction.
model StockBalance {
  id          String   @id @default(uuid())
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand      Int      @default(0) // physical units present at location
  reserved    Int      @default(0) // active (non-expired) reservations
  quarantined Int      @default(0) // damaged / unsellable, excluded from ATS
  updatedAt   DateTime @updatedAt

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
}

enum StockMovementType {
  RECEIPT
  SALE
  RETURN_RESTOCK
  RETURN_QUARANTINE
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_OUT
  TRANSFER_IN
  RESERVATION_CONVERT
  RESERVATION_RELEASE
}

// Append-only, immutable ledger. Never updated or deleted — corrections are
// made via new compensating movements, per the PDF's "immutable movement
// history, reversible adjustments via compensating events" rule.
model StockMovement {
  id            String            @id @default(uuid())
  variantId     String
  variant       Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  type          StockMovementType
  quantity      Int // always positive; direction implied by type
  reasonCode    String?
  referenceType String? // "Order" | "GoodsReceipt" | "Transfer" | "Count" | "Reservation"
  referenceId   String?
  performedById String?
  performedBy   User?             @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([variantId, locationId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

// Backs online-checkout and POS-deposit holds. expiresAt enforces the PDF's
// "reservation expiry" requirement; a background sweep (or lazy check at
// read-time) transitions ACTIVE -> EXPIRED and releases the held quantity.
model Reservation {
  id         String            @id @default(uuid())
  variantId  String
  variant    Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  orderId    String?
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([variantId, locationId, status])
  @@index([orderId])
  @@index([expiresAt])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELED
}

model Transfer {
  id             String         @id @default(uuid())
  variantId      String
  variant        Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  fromLocationId String
  fromLocation   Location       @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String
  toLocation     Location       @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  quantity       Int
  status         TransferStatus @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  @@index([variantId])
  @@index([status])
}

enum CountStatus {
  OPEN
  COMPLETED
  CANCELED
}

model Count {
  id          String      @id @default(uuid())
  locationId  String
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status      CountStatus @default(OPEN)
  notes       String?
  lines       CountLine[]
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  @@index([locationId])
}

model CountLine {
  id          String @id @default(uuid())
  countId     String
  count       Count  @relation(fields: [countId], references: [id], onDelete: Cascade)
  variantId   String
  expectedQty Int
  countedQty  Int?
  discrepancy Int?

  @@index([countId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Sales / Orders (e-commerce + shared order model)
// ---------------------------------------------------------------------------

model Customer {
  id        String    @id @default(uuid())
  email     String?   @unique
  phone     String?
  firstName String?
  lastName  String?
  addresses Address[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       AddressType
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("US")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([customerId])
}

// Three independent dimensions per the PDF's "source-of-truth workflows":
// order status, payment status, and fulfillment status are never conflated.
enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum FulfillmentStatus {
  UNALLOCATED
  RESERVED
  READY
  PICKED_UP
  DELIVERED
}

enum OrderChannel {
  ONLINE
  POS
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
  IN_STORE
}

model Order {
  id                String             @id @default(uuid())
  orderNumber       String             @unique // human-friendly sequential display number
  channel           OrderChannel
  customerId        String?
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status            OrderStatus        @default(DRAFT)
  paymentStatus     PaymentStatus      @default(UNPAID)
  fulfillmentStatus FulfillmentStatus  @default(UNALLOCATED)
  fulfillmentMethod FulfillmentMethod?
  subtotalCents     Int                @default(0)
  taxCents          Int                @default(0)
  deliveryFeeCents  Int                @default(0)
  discountCents     Int                @default(0)
  totalCents        Int                @default(0)
  deliveryAddressId String?
  deliveryNotes     String?
  assemblyNotes     String?
  scheduledDate     DateTime?
  lines             OrderLine[]
  payments          Payment[]
  refunds           Refund[]
  reservations      Reservation[]
  deliveries        Delivery[]
  pickups           Pickup[]
  statusHistory     StatusHistory[]
  receipts          Receipt[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([orderNumber])
}

// Historical snapshot of price/tax/discount at time of sale — never recompute
// from current catalog prices once an order line exists.
model OrderLine {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  skuSnapshot    String
  nameSnapshot   String
  quantity       Int
  unitPriceCents Int
  taxCents       Int      @default(0)
  discountCents  Int      @default(0)
  lineTotalCents Int
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

enum PaymentMethod {
  CASH
  CARD
  DEPOSIT
}

enum PaymentStatusDetail {
  PENDING
  SUCCEEDED
  FAILED
  VOIDED
}

// providerEventId enforces idempotency per the PDF: "never assume terminal
// pending means paid; payment confirmation and provider event idempotency
// are required."
model Payment {
  id              String              @id @default(uuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatusDetail @default(PENDING)
  amountCents     Int
  providerName    String?
  providerRef     String?
  providerEventId String?             @unique
  failureReason   String?
  events          ProviderEvent[]
  refunds         Refund[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderId])
  @@index([status])
}

model Refund {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amountCents   Int
  reasonCode    String
  notes         String?
  processedById String?
  createdAt     DateTime @default(now())

  @@index([orderId])
}

// Raw inbound webhook/provider events, kept for idempotency + audit, keyed on
// the provider's own event id so duplicate webhook deliveries are no-ops.
model ProviderEvent {
  id           String    @id @default(uuid())
  paymentId    String?
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerName String
  eventId      String    @unique
  eventType    String
  payload      Json
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([paymentId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// POS (in-store cashier app — apps/pos). Card-present tender is stubbed until
// a payment processor and terminal model are selected; see
// docs/requirements/open-questions.md.
// ---------------------------------------------------------------------------

model Register {
  id         String            @id @default(uuid())
  name       String
  locationId String?
  location   Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive   Boolean           @default(true)
  sessions   RegisterSession[]
  createdAt  DateTime          @default(now())

  @@index([locationId])
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

model RegisterSession {
  id                String                @id @default(uuid())
  registerId        String
  register          Register              @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedById        String?
  openedBy          User?                 @relation(fields: [openedById], references: [id], onDelete: SetNull)
  status            RegisterSessionStatus @default(OPEN)
  openingCashCents  Int                   @default(0)
  closingCashCents  Int?
  expectedCashCents Int?
  discrepancyCents  Int?
  cashMovements     CashMovement[]
  receipts          Receipt[]
  openedAt          DateTime              @default(now())
  closedAt          DateTime?

  @@index([registerId])
  @@index([status])
  @@index([openedById])
}

enum CashMovementType {
  SALE
  REFUND
  PAID_IN
  PAID_OUT
  DEPOSIT
}

model CashMovement {
  id                String           @id @default(uuid())
  registerSessionId String
  registerSession   RegisterSession  @relation(fields: [registerSessionId], references: [id], onDelete: Cascade)
  type              CashMovementType
  amountCents       Int
  notes             String?
  createdAt         DateTime         @default(now())

  @@index([registerSessionId])
}

model Receipt {
  id                String           @id @default(uuid())
  registerSessionId String?
  registerSession   RegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receiptNumber     String           @unique
  createdAt         DateTime         @default(now())

  @@index([registerSessionId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Purchasing / Receiving
// ---------------------------------------------------------------------------

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  leadTimeDays   Int?
  notes          String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum PurchaseOrderStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SENT_TO_VENDOR
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status        PurchaseOrderStatus @default(DRAFT)
  locationId    String
  expectedDate  DateTime?
  notes         String?
  createdById   String?
  createdBy     User?               @relation("POCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?               @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  lines         POLine[]
  goodsReceipts GoodsReceipt[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([poNumber])
}

model POLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         Variant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  skuSnapshot     String
  expectedQty     Int
  receivedQty     Int           @default(0)
  unitCostCents   Int
  taxCents        Int           @default(0)
  freightCents    Int           @default(0)
  receiptLines    ReceiptLine[]

  @@index([purchaseOrderId])
  @@index([variantId])
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receivedById    String?
  receivedBy      User?         @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  lines           ReceiptLine[]
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([locationId])
}

model ReceiptLine {
  id              String       @id @default(uuid())
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLineId        String
  poLine          POLine       @relation(fields: [poLineId], references: [id], onDelete: Restrict)
  acceptedQty     Int
  damagedQty      Int          @default(0)
  differenceNotes String?
  createdAt       DateTime     @default(now())

  @@index([goodsReceiptId])
  @@index([poLineId])
}

// ---------------------------------------------------------------------------
// Delivery / Fulfillment
// ---------------------------------------------------------------------------

model Delivery {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addressId     String?
  feeCents      Int       @default(0)
  scheduledDate DateTime?
  deliveredAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

model Pickup {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduledDate DateTime?
  pickedUpAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

model StatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field     String // "status" | "paymentStatus" | "fulfillmentStatus"
  fromValue String?
  toValue   String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}
