// Big Ed's Retail OS — core data model.
// Scope this pass: Auth/RBAC, Catalog, Inventory, Purchasing, Orders (e-commerce),
// POS (Register, RegisterSession, CashMovement).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

enum RoleName {
  // Every permission ADMIN has, plus invisible to every other user on the
  // admin Users page (see apps/api/src/routes/users.routes.js) — not an
  // ADMIN flag, a distinct tier so the hiding rule is keyed off role, not a
  // per-row special case.
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALESMAN
  CASHIER
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  passwordHash           String
  firstName              String
  lastName               String
  isActive               Boolean                 @default(true)
  // Human-readable badge number for attributing activities on receipts/audit
  // trails (MGR001, SLS001, CSH001 — see apps/api/src/lib/employeeId.js).
  // Null for Admin-only users: Admin was never part of this numbering. Picked
  // from the user's highest-priority role (Manager > Salesman > Cashier) and
  // regenerated whenever that set of roles changes, so it always matches the
  // role currently driving it rather than freezing at creation time.
  employeeId             String?                 @unique
  // POS discount-override PIN — a separate credential from passwordHash,
  // only ever set for managers/admins who need to authorize a cashier's
  // >10% discount from the register screen without logging the cashier out.
  // Hashed the same way as passwordHash (bcrypt); never returned by any API
  // response. Nullable: most staff never set one.
  posPinHash             String?
  posPinUpdatedAt        DateTime?
  roles                  UserRole[]
  auditLogs              AuditLog[]
  purchaseOrdersCreated  PurchaseOrder[]         @relation("POCreatedBy")
  purchaseOrdersApproved PurchaseOrder[]         @relation("POApprovedBy")
  goodsReceipts          GoodsReceipt[]
  stockMovements         StockMovement[]
  registerSessionsOpened RegisterSession[]       @relation("RegisterSessionOpenedBy")
  reopensRequested       RegisterSession[]       @relation("RegisterSessionReopenRequestedBy")
  reopensApproved        RegisterSession[]       @relation("RegisterSessionReopenApprovedBy")
  paymentsRung           Payment[]
  storeCreditEntries     StoreCredit[]
  returnsProcessed       ReturnTransaction[]
  salesAttributions      OrderSalesAttribution[] @relation("OrderSalesAttributions")
  discountApprovalsGiven Order[]                 @relation("OrderDiscountApprovedBy")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([email])
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "inventory:adjust", "purchasing:approve"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "stock.adjust", "po.approve", "order.refund"
  entityType String
  entityId   String
  reasonCode String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Products / Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  image       String?
  parentId    String?
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    Product[]
  productTags ProductCategory[]
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([slug])
}

// Secondary categories a product also appears under, beyond its primary
// Product.categoryId. A product's primary category drives admin-list display
// and the canonical breadcrumb; this join table is purely additive for
// "also show this product on these other category pages."
model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String?
  categoryId   String?
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryTags ProductCategory[]
  // Internal-only: `brand` and `supplier` are staff-facing catalog data and
  // must never be returned by the public storefront routes (see
  // serializeProduct's `includeInternal` in apps/api/src/routes/catalog.routes.js).
  brand        String?
  // Who we buy this product from. Nullable + SetNull so deleting/retiring a
  // Supplier never blocks or cascades into the catalog (PurchaseOrder keeps
  // its own non-null supplierId — this is just the product's default vendor).
  supplierId   String?
  supplier     Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Product-level display attributes shown on the storefront detail page.
  // Each is optional and hidden from the live page when not set — distinct
  // from Variant.color/size, which vary per sellable SKU.
  itemName     String?
  color        String?
  material     String?
  dimensions   String?
  status       ProductStatus     @default(DRAFT)
  // Manually flagged by staff to appear on the storefront Deals page,
  // independent of whether any variant has a compareAtCents markdown price.
  isDeal       Boolean           @default(false)
  // Staff-ticked on the admin form's Warranty tab. Public (unlike brand/
  // supplier): when true the storefront product page shows a "Warrantied"
  // marker plus `warrantyNote` as "Warranty Details" under the description.
  // Existing products default to false — no backfill. The API only ever
  // returns warrantyNote while isWarrantied is true (see serializeProduct), so
  // a leftover note on an un-ticked product can never reach the storefront.
  isWarrantied Boolean           @default(false)
  warrantyNote String?
  variants     Variant[]
  images       ProductImage[]
  videos       ProductVideo[]
  // Cross-links to OTHER, independently-sellable Products (e.g. a sectional
  // and a loveseat in the same collection) — distinct from Variant, which is
  // color/size options of this SAME product on one page. Always written and
  // removed symmetrically in pairs (see apps/api/src/routes/catalog.routes.js)
  // so "A links to B" and "B links to A" can never drift out of sync; the two
  // relation names below are just Prisma's required way to name each side of
  // a self-referential many-to-many, not a meaningful direction.
  linkedTo     ProductLink[]     @relation("ProductLinksFrom")
  linkedFrom   ProductLink[]     @relation("ProductLinksTo")
  reviews      Review[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([supplierId])
  @@index([status])
  @@index([isDeal])
}

model ProductLink {
  productId       String
  product         Product  @relation("ProductLinksFrom", fields: [productId], references: [id], onDelete: Cascade)
  linkedProductId String
  linkedProduct   Product  @relation("ProductLinksTo", fields: [linkedProductId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@id([productId, linkedProductId])
  @@index([linkedProductId])
}

enum ReviewStatus {
  // 4-5 star submissions land here directly (auto-published) — see
  // POST /products/:slug/reviews in catalog.routes.js.
  APPROVED
  // 1-3 star submissions land here and are hidden from the storefront until
  // staff act on them — surfaced as an alert badge on the admin Products
  // list/sidebar (see GET /admin/reviews/pending-count).
  PENDING
}

// A guest-submitted product review, not tied to a signed-in Customer account
// (this storefront's review form only ever asks for a name/email, mirroring
// how a guest Customer row is created implicitly at checkout — see
// Customer's own comment) — authorName/authorEmail are plain free-text, not
// an FK, so a review always keeps its original author info even if that
// email never becomes/isn't a registered Customer.
model Review {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int // 1-5, enforced by the Zod schema (packages/validation) — not a DB CHECK constraint
  body        String
  authorName  String
  authorEmail String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@index([productId])
  @@index([status])
}

enum ContactMessageStatus {
  // Just submitted, nobody on staff has opened it yet — the "unread" count
  // on the admin dashboard/sidebar badge.
  NEW
  READ
  // Staff-dismissed, kept for the record but excluded from the default admin
  // list view — mirrors Review's PENDING/APPROVED split in spirit (a status
  // that changes what's surfaced by default), though Messages has no
  // storefront-visibility angle, only an admin inbox-triage one.
  ARCHIVED
}

// A guest-submitted inquiry from the storefront's /contact page — same
// free-text-author convention as Review (no signed-in Customer tie-in; the
// contact form only ever asks for a name/email). isImportant is independent
// of status: staff can flag a NEW or READ message as important, and
// unflag it, without that affecting whether it's still unread.
model ContactMessage {
  id                       String               @id @default(uuid())
  name                     String
  email                    String
  message                  String
  status                   ContactMessageStatus @default(NEW)
  isImportant              Boolean              @default(false)
  // The four fields below are only ever populated by the storefront's
  // "Request Return" flow (My Orders -> Contact, POST /messages/return) —
  // every other ContactMessage (the plain /contact form) leaves them at
  // their defaults. Kept on this same model rather than a new table since a
  // return request is, at this stage, exactly a contact-form message with a
  // few extra fields — it is a request staff triage manually, not a
  // real inventory return (see ReturnTransaction for the actual in-store
  // return/refund flow, which this is deliberately separate from).
  isReturnRequest          Boolean              @default(false)
  // Free-text order id / bill no / invoice the customer typed, when they
  // didn't instead attach a file (returnAttachmentUrl). Either, both, or
  // neither may be set — the route only requires at least one.
  returnOrderReference     String?
  returnAttachmentUrl      String?
  returnAttachmentPublicId String?
  createdAt                DateTime             @default(now())

  @@index([status])
  @@index([isImportant])
  @@index([createdAt])
  @@index([isReturnRequest])
}

model Variant {
  id                        String          @id @default(uuid())
  productId                 String
  product                   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                       String          @unique
  name                      String // e.g. "Charcoal / Queen"
  color                     String?
  size                      String?
  widthInches               Decimal?        @db.Decimal(8, 2)
  heightInches              Decimal?        @db.Decimal(8, 2)
  depthInches               Decimal?        @db.Decimal(8, 2)
  weightLbs                 Decimal?        @db.Decimal(8, 2)
  priceCents                Int // current selling price, in cents (USD)
  compareAtCents            Int?
  costCents                 Int? // last known supplier cost, in cents
  // Sales tax rate, as a percentage (8.25 = 8.25%) — editable per product.
  // Not yet applied anywhere: Order.taxCents/OrderLine.taxCents exist but
  // nothing computes a non-zero value from them today (see
  // docs/requirements/open-questions.md, "Blocks: Tax calculation").
  taxRatePercent            Decimal         @default(8.25) @db.Decimal(5, 2)
  isActive                  Boolean         @default(true)
  priceHistory              PriceHistory[]
  stockBalances             StockBalance[]
  stockMovements            StockMovement[]
  reservations              Reservation[]
  transfers                 Transfer[]
  orderLines                OrderLine[]
  poLines                   POLine[]
  returnLines               ReturnLine[]
  replacementForReturnLines ReturnLine[]    @relation("ReturnLineReplacement")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  // Cloudinary public id (e.g. "products/abc123") — needed to delete or
  // transform this image via the Cloudinary API later. Null for images added
  // by pasting an external URL directly, which Cloudinary doesn't manage.
  publicId  String?
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Mirrors ProductImage exactly (same url/publicId/sortOrder shape, same
// full-replace-on-update semantics in catalog.routes.js) — kept as its own
// model rather than a `type` discriminator column on ProductImage because
// Cloudinary itself requires a distinct resource_type ("image" vs "video")
// at upload time, and the admin/storefront UIs render the two with
// completely different markup (<img>/<Image> vs <video>), so there's no
// shared query path that benefits from them living in one table.
model ProductVideo {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  // Cloudinary public id — null for videos added by pasting an external URL
  // directly, same convention as ProductImage.publicId.
  publicId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model PriceHistory {
  id          String   @id @default(uuid())
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceCents  Int
  costCents   Int?
  effectiveAt DateTime @default(now())
  changedBy   String?

  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Stock / Inventory
// ---------------------------------------------------------------------------

enum LocationType {
  SHOWROOM
  WAREHOUSE
}

model Location {
  id            String          @id @default(uuid())
  name          String
  type          LocationType
  isActive      Boolean         @default(true)
  stockBalances StockBalance[]
  movements     StockMovement[]
  reservations  Reservation[]
  transfersFrom Transfer[]      @relation("TransferFrom")
  transfersTo   Transfer[]      @relation("TransferTo")
  counts        Count[]
  goodsReceipts GoodsReceipt[]
  registers     Register[]
  createdAt     DateTime        @default(now())

  @@index([type])
}

// Running balance snapshot per (variant, location). Authoritative quantities
// are derived from StockMovement; this table is a materialized convenience
// cache that every mutating operation updates inside the same transaction.
model StockBalance {
  id          String   @id @default(uuid())
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand      Int      @default(0) // physical units present at location
  reserved    Int      @default(0) // active (non-expired) reservations
  quarantined Int      @default(0) // damaged / unsellable, excluded from ATS
  updatedAt   DateTime @updatedAt

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
}

enum StockMovementType {
  RECEIPT
  SALE
  RETURN_RESTOCK
  RETURN_QUARANTINE
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_OUT
  TRANSFER_IN
  RESERVATION_CONVERT
  RESERVATION_RELEASE
}

// Append-only, immutable ledger. Never updated or deleted — corrections are
// made via new compensating movements, per the PDF's "immutable movement
// history, reversible adjustments via compensating events" rule.
model StockMovement {
  id            String            @id @default(uuid())
  variantId     String
  variant       Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  type          StockMovementType
  quantity      Int // always positive; direction implied by type
  reasonCode    String?
  referenceType String? // "Order" | "GoodsReceipt" | "Transfer" | "Count" | "Reservation"
  referenceId   String?
  performedById String?
  performedBy   User?             @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([variantId, locationId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

// Backs online-checkout and POS-deposit holds. expiresAt enforces the PDF's
// "reservation expiry" requirement; a background sweep (or lazy check at
// read-time) transitions ACTIVE -> EXPIRED and releases the held quantity.
model Reservation {
  id         String            @id @default(uuid())
  variantId  String
  variant    Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  orderId    String?
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([variantId, locationId, status])
  @@index([orderId])
  @@index([expiresAt])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELED
}

model Transfer {
  id             String         @id @default(uuid())
  variantId      String
  variant        Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  fromLocationId String
  fromLocation   Location       @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String
  toLocation     Location       @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  quantity       Int
  status         TransferStatus @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  @@index([variantId])
  @@index([status])
}

enum CountStatus {
  OPEN
  COMPLETED
  CANCELED
}

model Count {
  id          String      @id @default(uuid())
  locationId  String
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status      CountStatus @default(OPEN)
  notes       String?
  lines       CountLine[]
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  @@index([locationId])
}

model CountLine {
  id          String @id @default(uuid())
  countId     String
  count       Count  @relation(fields: [countId], references: [id], onDelete: Cascade)
  variantId   String
  expectedQty Int
  countedQty  Int?
  discrepancy Int?

  @@index([countId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Sales / Orders (e-commerce + shared order model)
// ---------------------------------------------------------------------------

// Which flow first created this Customer row — ONLINE (storefront checkout
// or account registration) or POS (a cashier creating/attaching a walk-in
// customer). The two never merge into one row even when the same email is
// used in both: an online account's order history must never pick up an
// in-store sale (or vice versa) just because a cashier typed the same email
// a customer uses online. See Customer.email's own comment for how this
// interacts with uniqueness.
enum CustomerChannel {
  ONLINE
  POS
}

model Customer {
  id              String              @id @default(uuid())
  // Unique per channel, not globally — the same email can exist as both an
  // ONLINE row (their storefront account/guest checkouts) and a separate POS
  // row (their in-store purchase history), and the two are never merged. Every
  // lookup/upsert against email (checkout, registration, login, POS search)
  // must filter by channel to land on the right row.
  email           String?
  phone           String?
  firstName       String?
  lastName        String?
  channel         CustomerChannel
  // Storefront account credentials. Both stay null for guest customers — rows
  // created implicitly by checkout — so those keep working unchanged. A
  // customer can sign in only once both are set, which only happens after the
  // emailed one-time code has been confirmed (see CustomerRegistration). Never
  // set on a POS-channel row — POS customers don't have storefront logins.
  passwordHash    String?
  emailVerifiedAt DateTime?
  addresses       Address[]
  orders          Order[]
  storeCredits    StoreCredit[]
  returns         ReturnTransaction[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([email, channel])
  @@index([email])
}

// A storefront sign-up waiting on its emailed one-time code. Nothing is written
// to Customer until the code is confirmed, so an unverified sign-up can never
// create, overwrite, or take over a customer (or guest-order history) for an
// email address the submitter doesn't control. `id` is returned to the browser
// that started the sign-up and must accompany the code, so a code from some
// other sign-up attempt for the same email can't complete this one. Only a
// keyed hash of the code is stored, never the code itself.
model CustomerRegistration {
  id           String   @id @default(uuid())
  email        String
  firstName    String
  lastName     String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  resendCount  Int      @default(0)
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id               String      @id @default(uuid())
  // Optional: a POS sale's billing/shipping address is captured as a
  // freestanding snapshot row (customerId null) — it is what the customer
  // said at checkout, not necessarily their saved address book entry (e.g.
  // a gift delivery), and must never silently become their default saved
  // address. See Order.billingAddressId / Order.shippingAddressId.
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type             AddressType
  line1            String
  line2            String?
  city             String
  state            String
  postalCode       String
  country          String      @default("US")
  isDefault        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  billingForOrder  Order[]     @relation("OrderBillingAddress")
  shippingForOrder Order[]     @relation("OrderShippingAddress")

  @@index([customerId])
}

// Three independent dimensions per the PDF's "source-of-truth workflows":
// order status, payment status, and fulfillment status are never conflated.
enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum FulfillmentStatus {
  UNALLOCATED
  RESERVED
  // Staff-driven manual tracking step for online orders only (see
  // apps/api/src/services/orderStatus.service.js) — POS orders never pass
  // through this value, they go straight RESERVED -> READY.
  PROCESSING
  READY
  PICKED_UP
  DELIVERED
}

enum OrderChannel {
  ONLINE
  POS
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
  IN_STORE
}

model Order {
  id                   String                  @id @default(uuid())
  orderNumber          String                  @unique // human-friendly sequential display number
  channel              OrderChannel
  customerId           String?
  customer             Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status               OrderStatus             @default(DRAFT)
  paymentStatus        PaymentStatus           @default(UNPAID)
  fulfillmentStatus    FulfillmentStatus       @default(UNALLOCATED)
  fulfillmentMethod    FulfillmentMethod?
  subtotalCents        Int                     @default(0)
  taxCents             Int                     @default(0)
  deliveryFeeCents     Int                     @default(0)
  discountCents        Int                     @default(0)
  totalCents           Int                     @default(0)
  deliveryAddressId    String?
  deliveryNotes        String?
  assemblyNotes        String?
  scheduledDate        DateTime?
  // Percent-mode discount metadata only — discountCents (above) is always
  // the resolved, server-computed source of truth for money actually
  // applied, regardless of whether the cashier chose percent or flat-dollar
  // mode. Null when flat-dollar mode was used.
  discountPercent      Int?
  // Set only when the discount exceeded the unsupervised cashier ceiling
  // (10%) and a manager/admin authorized it via their POS PIN. Duplicates
  // what the AuditLog "pos.sale.discount" entry already records in detail —
  // kept here too as a direct, indexed column so "which orders did manager
  // X approve" doesn't require scanning/parsing AuditLog.metadata JSON.
  discountApprovedById String?
  discountApprovedBy   User?                   @relation("OrderDiscountApprovedBy", fields: [discountApprovedById], references: [id], onDelete: SetNull)
  // What the customer verbally said they want for delivery timing — a
  // free-form cashier-entered note of intent, distinct from scheduledDate
  // (which Delivery/Pickup's own fulfillment-console workflow owns).
  requestedDeliveryAt  DateTime?
  // Stamped once, the first time staff set the unified displayStatus to
  // "Completed" via PATCH /admin/orders/:id/status (see
  // orders.routes.js) — never overwritten by a later status change, so it
  // always reflects the original completion date. Null for any order that
  // hasn't reached Completed yet, and for orders that completed before this
  // column existed (no retroactive backfill). Backs the storefront's
  // "Return" window (7 days from this date) on apps/storefront's My Orders.
  completedAt          DateTime?
  // POS-captured billing/shipping address snapshots for a delivery sale —
  // freestanding Address rows (customerId null), never the customer's saved
  // address book. See Address.customerId comment.
  billingAddressId     String?
  billingAddress       Address?                @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingAddressId    String?
  shippingAddress      Address?                @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  lines                OrderLine[]
  payments             Payment[]
  refunds              Refund[]
  reservations         Reservation[]
  deliveries           Delivery[]
  pickups              Pickup[]
  statusHistory        StatusHistory[]
  receipts             Receipt[]
  returnTransactions   ReturnTransaction[]     @relation("ReturnTransactionOrder")
  exchangeOfReturns    ReturnTransaction[]     @relation("ReturnTransactionExchangeOrder")
  storeCreditEntries   StoreCredit[]
  salesAttributions    OrderSalesAttribution[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([discountApprovedById])
}

// Credits 1-2 staff members (salesman and/or manager) for a sale, with an
// optional split percent between them — backs the admin Users drill-down
// ("sales credited to this person"). userId is Restrict (not SetNull)
// because this app never hard-deletes User rows (only deactivates via
// isActive) and attribution history is the entire point of this model; a
// deactivated user must keep their historical credit intact.
enum SalesAttributionRole {
  SALESMAN
  MANAGER
}

model OrderSalesAttribution {
  id           String               @id @default(uuid())
  orderId      String
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation("OrderSalesAttributions", fields: [userId], references: [id], onDelete: Restrict)
  role         SalesAttributionRole
  splitPercent Int
  createdAt    DateTime             @default(now())

  @@unique([orderId, userId])
  @@index([orderId])
  @@index([userId])
}

// Historical snapshot of price/tax/discount at time of sale — never recompute
// from current catalog prices once an order line exists.
model OrderLine {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  skuSnapshot    String
  nameSnapshot   String
  quantity       Int
  unitPriceCents Int
  taxCents       Int          @default(0)
  discountCents  Int          @default(0)
  lineTotalCents Int
  returnLines    ReturnLine[]
  createdAt      DateTime     @default(now())

  @@index([orderId])
  @@index([variantId])
}

enum PaymentMethod {
  CASH
  CARD
  DEPOSIT
  BANK_TRANSFER
  STORE_CREDIT
}

enum PaymentStatusDetail {
  PENDING
  SUCCEEDED
  FAILED
  VOIDED
}

// providerEventId enforces idempotency per the PDF: "never assume terminal
// pending means paid; payment confirmation and provider event idempotency
// are required."
model Payment {
  id              String              @id @default(uuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatusDetail @default(PENDING)
  amountCents     Int
  // Free-text tender reference (last-4 of a card, a check number, a gift
  // reference) — distinct from providerRef, which is a payment *provider's*
  // own transaction id (Stripe etc.), not applicable to in-person POS tenders.
  reference       String?
  // Attributes a specific tender entry to the cashier who rang it. Distinct
  // from the indirect Payment -> Order -> Receipt -> RegisterSession ->
  // openedBy join (docs/database/schema.md), which only identifies who opened
  // the register, not who rang this particular tender within a split sale.
  performedById   String?
  performedBy     User?               @relation(fields: [performedById], references: [id], onDelete: SetNull)
  providerName    String?
  providerRef     String?
  providerEventId String?             @unique
  failureReason   String?
  events          ProviderEvent[]
  refunds         Refund[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([performedById])
}

model Refund {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amountCents   Int
  reasonCode    String
  notes         String?
  processedById String?
  createdAt     DateTime @default(now())

  @@index([orderId])
}

// Raw inbound webhook/provider events, kept for idempotency + audit, keyed on
// the provider's own event id so duplicate webhook deliveries are no-ops.
model ProviderEvent {
  id           String    @id @default(uuid())
  paymentId    String?
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerName String
  eventId      String    @unique
  eventType    String
  payload      Json
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([paymentId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Store credit — minimal append-only ledger, same shape as CashMovement/
// StockMovement: balance is always computed as sum(amountCents) for a
// customer, never stored directly. Issued only by a return/exchange
// (reason ISSUED_FROM_RETURN); redeemed only as a POS split-payment tender
// (reason REDEEMED, amountCents negative). Always tied to a Customer — store
// credit can never be anonymous/guest, since there would be no way to redeem
// it later.
// ---------------------------------------------------------------------------

enum StoreCreditReason {
  ISSUED_FROM_RETURN
  REDEEMED
}

model StoreCredit {
  id                  String             @id @default(uuid())
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amountCents         Int // positive = issued, negative = redeemed
  reason              StoreCreditReason
  returnTransactionId String?
  returnTransaction   ReturnTransaction? @relation(fields: [returnTransactionId], references: [id], onDelete: SetNull)
  orderId             String?
  order               Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  performedById       String?
  performedBy         User?              @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  @@index([customerId])
  @@index([returnTransactionId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// POS returns / exchanges. A ReturnTransaction is the header for one return
// or exchange event against one original POS order; ReturnLine records each
// returned OrderLine's quantity/condition/reason, and (for an exchange) the
// replacement variant it was swapped for. "Previously returned quantity" per
// OrderLine is deliberately NOT a stored column — it's computed by summing
// ReturnLine.quantity grouped by orderLineId, same "never store what can be
// computed" rule availableToSell already follows.
// ---------------------------------------------------------------------------

enum ReturnCondition {
  SELLABLE
  DAMAGED
  QUARANTINED
  REQUIRES_INSPECTION
}

enum ReturnReasonCode {
  CUSTOMER_CHANGED_MIND
  DAMAGED_PRODUCT
  WRONG_PRODUCT
  DEFECTIVE_PRODUCT
  OTHER
}

model ReturnTransaction {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation("ReturnTransactionOrder", fields: [orderId], references: [id], onDelete: Restrict)
  receiptNumber      String          @unique
  registerSessionId  String
  registerSession    RegisterSession @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Set only when this return is one leg of an exchange — the new Order
  // created for the replacement item(s), kept as its own real Order so
  // existing order/receipt/payments machinery needs no special-casing.
  exchangeOrderId    String?
  exchangeOrder      Order?          @relation("ReturnTransactionExchangeOrder", fields: [exchangeOrderId], references: [id], onDelete: SetNull)
  totalRefundCents   Int
  reasonSummary      String?
  lines              ReturnLine[]
  storeCreditEntries StoreCredit[]
  performedById      String?
  performedBy        User?           @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())

  @@index([orderId])
  @@index([registerSessionId])
  @@index([customerId])
  @@index([exchangeOrderId])
}

model ReturnLine {
  id                   String            @id @default(uuid())
  returnTransactionId  String
  returnTransaction    ReturnTransaction @relation(fields: [returnTransactionId], references: [id], onDelete: Cascade)
  orderLineId          String
  orderLine            OrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  variantId            String
  variant              Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity             Int
  unitRefundCents      Int
  condition            ReturnCondition
  reasonCode           ReturnReasonCode
  // Set only when this line is the "returned" half of an exchange — the
  // variant it was swapped for (the replacement's own sale is a normal
  // OrderLine on exchangeOrder, not modeled here).
  replacementVariantId String?
  replacementVariant   Variant?          @relation("ReturnLineReplacement", fields: [replacementVariantId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())

  @@index([returnTransactionId])
  @@index([orderLineId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// POS (in-store cashier app — apps/pos). Card-present tender uses Square
// Terminal (see apps/api/src/services/pos.service.js's createCardCheckout
// and apps/api/src/routes/webhooks.routes.js's terminal.checkout.updated
// handler) — see docs/requirements/open-questions.md for what's still
// pending (a register's squareDeviceId must be set, from the real Square
// Dashboard's device-code pairing flow, before that register can take a
// card-present sale).
// ---------------------------------------------------------------------------

model Register {
  id             String            @id @default(uuid())
  name           String
  locationId     String?
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive       Boolean           @default(true)
  // The physical Square Terminal device paired to this register, if any —
  // null means this register can't take a card-present sale yet (ringSale's
  // CARD rejection falls back to this case). Set via Square's device-code
  // pairing flow (see the Square Dashboard), not something this app can
  // provision on its own — there is no "create a device" API call, only
  // "send a checkout to an already-paired device's ID."
  squareDeviceId String?
  sessions       RegisterSession[]
  createdAt      DateTime          @default(now())

  @@index([locationId])
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
  // Set when a cashier finds this register's previous session still OPEN
  // (left stuck — not closed out correctly) and submits a reopen request
  // instead of closing it themselves. The register cannot be opened again
  // until an admin/manager approves (-> CLOSED) or denies (-> back to OPEN)
  // the request. See pos:register:approve-reopen.
  PENDING_REOPEN_APPROVAL
}

model RegisterSession {
  id                  String                @id @default(uuid())
  registerId          String
  register            Register              @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedById          String?
  openedBy            User?                 @relation("RegisterSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  status              RegisterSessionStatus @default(OPEN)
  openingCashCents    Int                   @default(0)
  closingCashCents    Int?
  expectedCashCents   Int?
  discrepancyCents    Int?
  cashMovements       CashMovement[]
  receipts            Receipt[]
  returnTransactions  ReturnTransaction[]
  openedAt            DateTime              @default(now())
  closedAt            DateTime?
  reopenRequestedById String?
  reopenRequestedBy   User?                 @relation("RegisterSessionReopenRequestedBy", fields: [reopenRequestedById], references: [id], onDelete: SetNull)
  reopenRequestedAt   DateTime?
  reopenApprovedById  String?
  reopenApprovedBy    User?                 @relation("RegisterSessionReopenApprovedBy", fields: [reopenApprovedById], references: [id], onDelete: SetNull)
  reopenApprovedAt    DateTime?
  reopenDeniedAt      DateTime?
  reopenDenialReason  String?

  // A second partial-unique index enforces at most one OPEN/PENDING_REOPEN_
  // APPROVAL session per register — Prisma's schema DSL can't express a
  // partial (WHERE-filtered) unique index, so it's added via raw SQL in
  // migration 20261125_register_session_one_open_per_register and only
  // documented here; openRegister() in pos.service.js catches the resulting
  // unique-violation and surfaces it as the same ConflictError the
  // check-then-create path already throws.
  @@index([registerId])
  @@index([status])
  @@index([openedById])
}

enum CashMovementType {
  SALE
  REFUND
  PAID_IN
  PAID_OUT
  DEPOSIT
}

model CashMovement {
  id                String           @id @default(uuid())
  registerSessionId String
  registerSession   RegisterSession  @relation(fields: [registerSessionId], references: [id], onDelete: Cascade)
  type              CashMovementType
  amountCents       Int
  notes             String?
  createdAt         DateTime         @default(now())

  @@index([registerSessionId])
}

model Receipt {
  id                String           @id @default(uuid())
  registerSessionId String?
  registerSession   RegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receiptNumber     String           @unique
  createdAt         DateTime         @default(now())

  @@index([registerSessionId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Purchasing / Receiving
// ---------------------------------------------------------------------------

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  leadTimeDays   Int?
  notes          String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  products       Product[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum PurchaseOrderStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SENT_TO_VENDOR
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status        PurchaseOrderStatus @default(DRAFT)
  locationId    String
  notes         String?
  createdById   String?
  createdBy     User?               @relation("POCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?               @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  lines         POLine[]
  goodsReceipts GoodsReceipt[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([poNumber])
}

model POLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         Variant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  skuSnapshot     String
  expectedQty     Int
  receivedQty     Int           @default(0)
  unitCostCents   Int
  taxCents        Int           @default(0)
  freightCents    Int           @default(0)
  // Per-line delivery expectation — replaces the old PO-level expectedDate so
  // a single PO spanning multiple SKUs can have different expected dates per
  // item instead of one date forced across every line.
  expectedDate    DateTime?
  // Running "balance owed" status set when a receipt leaves this line short
  // (receivedQty < expectedQty) — overwritten on each partial receive, not an
  // append-only history (ReceiptLine.differenceNotes already is that ledger).
  // Cleared back to null once the line is fully received.
  pendingNote     String?
  receiptLines    ReceiptLine[]

  @@index([purchaseOrderId])
  @@index([variantId])
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receivedById    String?
  receivedBy      User?         @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  lines           ReceiptLine[]
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([locationId])
}

model ReceiptLine {
  id              String       @id @default(uuid())
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLineId        String
  poLine          POLine       @relation(fields: [poLineId], references: [id], onDelete: Restrict)
  acceptedQty     Int
  damagedQty      Int          @default(0)
  differenceNotes String?
  createdAt       DateTime     @default(now())

  @@index([goodsReceiptId])
  @@index([poLineId])
}

// ---------------------------------------------------------------------------
// Delivery / Fulfillment
// ---------------------------------------------------------------------------

model Delivery {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addressId     String?
  feeCents      Int       @default(0)
  scheduledDate DateTime?
  deliveredAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

model Pickup {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduledDate DateTime?
  pickedUpAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

model StatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field     String // "status" | "paymentStatus" | "fulfillmentStatus" | "displayStatus" (the
  // staff-facing unified status set via PATCH /admin/orders/:id/status — see
  // apps/api/src/services/orderStatus.service.js; a single row here can
  // represent a change that actually wrote 1-2 of the real fields above)
  fromValue String?
  toValue   String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Sequence counters
// ---------------------------------------------------------------------------

// Backs every human-readable sequential number (order/receipt/PO numbers,
// employee ids) with a single atomically-incrementable row per sequence,
// instead of the previous count()+1 pattern — see
// apps/api/src/lib/sequentialNumber.js for why count()+1 isn't safe under
// concurrency (two reads of the same count can both "win" and collide on the
// unique number column) and how `key` values are named per sequence.
model SequenceCounter {
  key   String @id
  value Int    @default(0)
}
