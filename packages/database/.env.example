# --- Local development ---
# Local Postgres install:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/big_eds_retail_os?schema=public"

# Or a free cloud Postgres instance (no local install needed) — Neon example:
# DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/big_eds_retail_os?sslmode=require"

# Optional: override the seeded admin login (printed to the console by
# `pnpm db:seed` if not set). Change this immediately in any shared/deployed
# environment.
# SEED_ADMIN_EMAIL="admin@bigedsfurniture.com"
# SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Render production value ---
# Use the "Internal Connection String" from your Render Postgres instance
# when running migrate/seed commands against production from your machine,
# or the "External Connection String" if connecting from outside Render's
# network. render.yaml wires DATABASE_URL into the API service automatically
# when deployed via Render Blueprint — you only need this file for running
# `pnpm db:migrate` / `pnpm db:seed` locally against that same database.
